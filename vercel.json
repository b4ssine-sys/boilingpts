{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install -r requirements-web.txt",
  "buildCommand": "python3 scripts/build_web.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
